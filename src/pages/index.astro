---
import Base from '../layouts/Base.astro';
import ParticleField from '../components/ParticleField.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Experience from '../components/Experience.astro';
import { site, heroVerbs, stack, facts } from '../data/site';
import { getPosts, getProjects, formatDate, readingTime } from '../lib/utils';

const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured);
const posts = (await getPosts()).slice(0, 4);

const intro =
  "I'm a software engineer at Innovation Quotient in Colombo, building full-stack products end to end — from .NET Core APIs and database schemas to React and Next.js interfaces, deployed on Azure. Alongside work, I am finishing my final year of Computer Science at IIT and researching how AI fits into real software.";

// Months since joining Innovation Quotient (May 2025), worked out at build time.
const now = new Date();
const monthsAtIQ = (now.getFullYear() - 2025) * 12 + now.getMonth() - 4;
const professional = projects.filter((p) => p.data.kind === 'Professional').length;

const numbers = [
  { n: monthsAtIQ, suffix: '+', label: 'Months shipping production software at Innovation Quotient' },
  { n: professional, suffix: '', label: 'Professional platforms — health-tech, streaming, logistics, kids\' events & HR' },
  { n: 12, suffix: '', label: 'Certificates — Stanford & DeepLearning.AI, UoM, HackerRank' },
  { n: 3, suffix: '', label: 'Languages spoken — English, Sinhala, Malay' },
];
---

<Base>
  <!-- ───────── Hero ───────── -->
  <section class="hero">
    <div class="hero__field">
      <ParticleField src="/images/portrait-side.jpg" align="right" label="Portrait of Farhan Hameeth drawn in particles" />
    </div>

    <div class="wrap hero__inner">
      <div class="hero__top mono">
        <span class="chip"><span class="dot"></span>{site.availability}</span>
        <span class="hero__loc muted">Colombo, LK — <span data-clock>--:--:--</span></span>
      </div>

      <h1 class="display hero__title">
        <span class="split-line" data-split style="--d:.05s"><span>Farhan</span></span>
        <span class="split-line" data-split style="--d:.15s"><span><span class="serif italic">Hameeth</span><span class="accent">*</span></span></span>
      </h1>

      <div class="hero__bottom">
        <p class="hero__build">
          <span class="muted">I build</span>
          <span class="hero__verb" data-scramble data-words={JSON.stringify(heroVerbs)}>{heroVerbs[0]}</span>
        </p>
        <p class="hero__sub muted">
          <span class="accent">*</span> {site.role} at {site.company}. Final-year CS at IIT · University of Westminster. .NET Core, React, Next.js, Azure.
        </p>
        <div class="hero__cta">
          <a href="/projects" class="btn btn--solid" data-magnetic="0.25">See my work
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a href="/about" class="btn" data-magnetic="0.25">About me</a>
        </div>
      </div>

      <div class="hero__hint mono muted" aria-hidden="true">
        <span class="hero__hint-fine">Move · click · scroll</span>
        <span class="hero__hint-touch">Tap the portrait</span>
        <span class="hero__scroll"><span></span></span>
      </div>
    </div>
  </section>

  <!-- ───────── Marquee ───────── -->
  <section class="marquee" aria-label="Tech stack">
    {[0, 1].map((row) => (
      <div class:list={['marquee__row', { 'marquee__row--rev': row === 1 }]}>
        {[0, 1].map(() => (
          <div class="marquee__set" aria-hidden={row === 1 ? 'true' : undefined}>
            {(row === 0 ? stack : [...stack].reverse()).map((s, i) => (
              <span class:list={['marquee__item', { serif: i % 3 === 1, italic: i % 3 === 1 }]}>{s}<span class="marquee__star">✦</span></span>
            ))}
          </div>
        ))}
      </div>
    ))}
  </section>

  <!-- ───────── Intro statement ───────── -->
  <section class="section">
    <div class="wrap intro">
      <p class="label">( 01 ) — Hello</p>
      <p class="intro__text" data-scroll-words>
        {intro.split(' ').map((w) => <span class="w">{w} </span>)}
      </p>
      <dl class="facts">
        {facts.map((f, i) => (
          <div class="facts__row" data-reveal style={`--d:${i * 0.06}s`}>
            <dt class="mono muted">{f.k}</dt>
            <dd>{f.v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ───────── Experience ───────── -->
  <section class="section xp-sec">
    <div class="wrap xp-grid">
      <div class="xp-side">
        <p class="label">( 02 ) — Where I work</p>
        <h2 class="h2">From intern to <span class="serif italic accent">engineer.</span></h2>
        <p class="muted">Joined Innovation Quotient as an intern in May 2025 and was promoted to Associate Software Engineer in January 2026.</p>
        <a href="/about#experience" class="link mono">Full experience →</a>
      </div>
      <Experience compact />
    </div>
  </section>

  <!-- ───────── Selected work: horizontal scroll ───────── -->
  <section class="work" data-hscroll>
    <div class="work__sticky">
      <div class="wrap work__head">
        <p class="label">( 03 ) — Selected work</p>
        <a href="/projects" class="link mono">All projects ({projects.length}) →</a>
      </div>
      <div class="work__track" data-hscroll-track>
        <div class="work__intro">
          <h2 class="h2">Things I've<br /><span class="serif italic accent">built</span> lately.</h2>
          <p class="muted">My final-year AI research, production platforms from Innovation Quotient and freelance work. Keep scrolling →</p>
        </div>
        {featured.map((p, i) => (
          <div class="work__card"><ProjectCard project={p} index={i} variant="wide" /></div>
        ))}
        <a href="/projects" class="work__more" data-cursor="Open">
          <span class="h3">See every<br />project</span>
          <span class="work__more-arrow">→</span>
        </a>
      </div>
      <div class="wrap work__progress"><span data-hscroll-bar></span></div>
    </div>
  </section>

  <!-- ───────── Numbers ───────── -->
  <section class="section">
    <div class="wrap">
      <p class="label">( 04 ) — By the numbers</p>
      <div class="nums">
        {numbers.map((n, i) => (
          <div class="nums__item" data-reveal style={`--d:${i * 0.08}s`}>
            <p class="nums__n"><span data-count={n.n}>0</span><span class="accent">{n.suffix}</span></p>
            <p class="muted">{n.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ───────── Writing ───────── -->
  <section class="section writing">
    <div class="wrap">
      <div class="writing__head">
        <div>
          <p class="label">( 05 ) — Writing</p>
          <h2 class="h2" style="margin-top:1.2rem">Notes from the<br /><span class="serif italic">workbench.</span></h2>
        </div>
        <a href="/blog" class="btn" data-magnetic="0.25">All posts</a>
      </div>
      <ul class="posts">
        {posts.map((p) => (
          <li data-reveal>
            <a href={`/blog/${p.id}`} class="posts__row" data-cursor="Read">
              <span class="mono muted">{formatDate(p.data.date, 'short')}</span>
              <span class="posts__title">{p.data.title}</span>
              <span class="mono muted posts__rt">{readingTime(p.body)} min</span>
              <span class="posts__arrow">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero { position: relative; min-height: 100svh; display: flex; overflow: hidden; }
  .hero__field { position: absolute; inset: 90px 3% 150px 40%; }
  .hero__inner { position: relative; z-index: 1; display: flex; flex-direction: column; justify-content: space-between; padding-top: 110px; padding-bottom: 40px; min-height: 100svh; pointer-events: none; }
  .hero__inner a, .hero__inner button { pointer-events: auto; }
  .hero__top { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .hero__loc { font-size: 0.72rem; }
  .hero__title { margin-top: auto; padding-top: 8vh; font-size: clamp(4rem, 15vw, 15rem); }
  .hero__title .serif { letter-spacing: -0.04em; padding-right: 0.04em; }
  .hero__bottom { display: grid; grid-template-columns: 1.2fr 1fr auto; gap: 2rem; align-items: end; margin-top: 2.5rem; }
  .hero__build { font-size: clamp(1.3rem, 2.4vw, 2rem); letter-spacing: -0.03em; line-height: 1.2; display: flex; flex-direction: column; }
  .hero__verb { min-height: 1.2em; }
  .hero__sub { max-width: 40ch; font-size: 0.98rem; }
  .hero__cta { display: flex; gap: 0.7rem; flex-wrap: wrap; }
  .hero__hint { position: absolute; right: var(--gutter); top: 50%; display: flex; flex-direction: column; align-items: center; gap: 1rem; writing-mode: vertical-rl; font-size: 0.66rem; letter-spacing: 0.12em; }
  .hero__hint-touch { display: none; }
  .hero__scroll { width: 1px; height: 70px; background: var(--line); position: relative; overflow: hidden; }
  .hero__scroll span { position: absolute; inset: 0; background: var(--accent); animation: drip 2s var(--ease-in-out) infinite; }
  @keyframes drip { 0% { transform: translateY(-100%); } 100% { transform: translateY(100%); } }

  @media (max-width: 1100px) {
    .hero__bottom { grid-template-columns: 1fr 1fr; }
    .hero__cta { grid-column: 1 / -1; }
  }
  @media (max-width: 900px) {
    .hero__field { inset: 120px -10% 30% 10%; opacity: 0.6; }
    .hero__bottom { grid-template-columns: 1fr; gap: 1.2rem; }
    .hero__hint { display: none; }
  }
  @media (hover: none) { .hero__hint-fine { display: none; } .hero__hint-touch { display: inline; } }

  /* Marquee */
  .marquee { border-block: 1px solid var(--line); padding-block: 1.6rem; overflow: hidden; display: grid; gap: 0.6rem; }
  .marquee__row { display: flex; width: max-content; animation: marq 40s linear infinite; }
  .marquee__row--rev { animation-direction: reverse; animation-duration: 48s; }
  .marquee:hover .marquee__row { animation-play-state: paused; }
  .marquee__set { display: flex; }
  .marquee__item { display: inline-flex; align-items: center; font-size: clamp(2rem, 5vw, 4.2rem); letter-spacing: -0.04em; line-height: 1.1; padding-right: 2.2rem; white-space: nowrap; }
  .marquee__row--rev .marquee__item { color: transparent; -webkit-text-stroke: 1px var(--line-2); }
  .marquee__row--rev .marquee__item.serif { color: var(--muted); -webkit-text-stroke: 0; }
  .marquee__star { font-size: 0.4em; color: var(--accent); padding-left: 2.2rem; -webkit-text-stroke: 0; }
  @keyframes marq { to { transform: translateX(-50%); } }

  /* Intro */
  .intro { display: grid; gap: 3rem; }
  .intro__text { font-size: clamp(1.7rem, 4.2vw, 3.8rem); line-height: 1.12; letter-spacing: -0.035em; max-width: 22ch; max-width: 1200px; }
  .intro__text .w { transition: opacity 0.2s linear; }
  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); margin: 2rem 0 0; border-top: 1px solid var(--line); }
  .facts__row { padding: 1.2rem 1.2rem 1.2rem 0; border-bottom: 1px solid var(--line); }
  .facts dt { font-size: 0.68rem; margin-bottom: 0.4rem; }
  .facts dd { margin: 0; font-size: 1.05rem; }

  /* Experience */
  .xp-sec { padding-top: 0; }
  .xp-grid { display: grid; grid-template-columns: 1fr 1.4fr; gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .xp-side { position: sticky; top: 110px; display: grid; gap: 1.4rem; }
  .xp-side .muted { max-width: 40ch; }
  .xp-side .link { justify-self: start; }
  @media (max-width: 900px) { .xp-grid { grid-template-columns: 1fr; } .xp-side { position: static; } }

  /* Work */
  .work { position: relative; }
  .work__sticky { position: sticky; top: 0; height: 100vh; display: flex; flex-direction: column; justify-content: center; gap: 2.5rem; overflow: hidden; padding-top: 70px; }
  .work__head { display: flex; justify-content: space-between; align-items: center; }
  .work__track { display: flex; gap: clamp(1.5rem, 3vw, 3rem); padding-inline: var(--gutter); will-change: transform; width: max-content; align-items: center; }
  .work__intro { width: min(420px, 80vw); display: grid; gap: 1.5rem; flex: none; }
  .work__card { width: min(560px, 42vw); flex: none; }
  .work__more { flex: none; width: 260px; aspect-ratio: 1; border-radius: 50%; border: 1px solid var(--line-2); display: grid; place-items: center; text-align: center; align-content: center; gap: 1rem; transition: background-color 0.5s var(--ease), color 0.5s; margin-right: var(--gutter); }
  .work__more:hover { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
  .work__more-arrow { font-size: 2rem; transition: transform 0.5s var(--ease); }
  .work__more:hover .work__more-arrow { transform: translateX(10px); }
  .work__progress { height: 1px; background: var(--line); position: relative; }
  .work__progress span { position: absolute; inset: 0; background: var(--accent); transform-origin: left; transform: scaleX(0); }

  @media (max-width: 900px) {
    .work { padding-block: 80px; }
    .work__sticky { position: static; height: auto; padding-top: 0; }
    .work__track { flex-direction: column; width: auto; align-items: stretch; }
    .work__intro, .work__card { width: 100%; }
    .work__more { width: 200px; align-self: center; margin-right: 0; }
    .work__progress { display: none; }
  }

  /* Numbers */
  .nums { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 3rem; border-top: 1px solid var(--line); }
  .nums__item { padding: 2rem 1.5rem 2rem 0; border-right: 1px solid var(--line); display: grid; gap: 0.8rem; align-content: start; }
  .nums__item:not(:first-child) { padding-left: 1.5rem; }
  .nums__item:last-child { border-right: 0; }
  .nums__n { font-size: clamp(4rem, 9vw, 8.5rem); line-height: 0.9; letter-spacing: -0.06em; font-weight: 500; }
  @media (max-width: 900px) {
    .nums { grid-template-columns: 1fr 1fr; }
    .nums__item { border-bottom: 1px solid var(--line); padding-left: 0 !important; }
    .nums__item:nth-child(odd) { padding-right: 1rem; }
    .nums__item:nth-child(even) { border-right: 0; padding-left: 1rem !important; }
  }

  /* Writing */
  .writing__head { display: flex; justify-content: space-between; align-items: end; gap: 2rem; flex-wrap: wrap; }
  .posts { list-style: none; padding: 0; margin: 3.5rem 0 0; border-top: 1px solid var(--line); }
  .posts__row { position: relative; display: grid; grid-template-columns: 140px 1fr auto auto; gap: 2rem; align-items: center; padding: 1.8rem 0; border-bottom: 1px solid var(--line); overflow: hidden; isolation: isolate; }
  .posts__row::before { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--bg-2); transform: scaleY(0); transform-origin: bottom; transition: transform 0.5s var(--ease); }
  .posts__row:hover::before { transform: scaleY(1); }
  .posts__title { font-size: clamp(1.3rem, 2.6vw, 2.2rem); letter-spacing: -0.035em; line-height: 1.15; transition: transform 0.5s var(--ease); }
  .posts__row:hover .posts__title { transform: translateX(14px); }
  .posts__arrow { font-size: 1.4rem; transition: transform 0.5s var(--ease), color 0.3s; }
  .posts__row:hover .posts__arrow { transform: translateX(-10px) rotate(-45deg); color: var(--accent); }
  @media (max-width: 700px) {
    .posts__row { grid-template-columns: 1fr auto; gap: 0.5rem 1rem; }
    .posts__title { grid-column: 1 / -1; grid-row: 2; }
    .posts__rt { display: none; }
  }
</style>
