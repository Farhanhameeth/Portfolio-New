---
import { nav, site, socials } from '../data/site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="nav" data-nav>
  <div class="nav__inner wrap">
    <a href="/" class="nav__logo" aria-label={`${site.name} — home`} data-magnetic>
      <span class="nav__mark">
        <svg viewBox="0 0 40 40" aria-hidden="true"><rect x="1" y="1" width="38" height="38" rx="11" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M11 28V12h9M11 20h7M24 12v16M24 20h7M31 12v16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
      <span class="nav__name">Farhan<span class="accent">.</span></span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      {nav.map((n, i) => (
        <a href={n.href} class:list={['nav__link', { 'is-active': isActive(n.href) }]} aria-current={isActive(n.href) ? 'page' : undefined}>
          <span class="nav__idx">0{i + 1}</span>
          <span class="nav__roll" data-text={n.label}><span>{n.label}</span></span>
        </a>
      ))}
    </nav>

    <div class="nav__tools">
      <button class="nav__k" data-open-palette aria-label="Open command menu">
        <span class="mono">Menu</span><kbd>⌘K</kbd>
      </button>
      <button class="nav__theme" data-theme-toggle aria-label="Toggle colour theme" data-magnetic>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor"/></svg>
      </button>
      <button class="nav__burger" data-burger aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <span></span><span></span>
      </button>
    </div>
  </div>

  <div class="mmenu" id="mobile-menu" data-mmenu aria-hidden="true">
    <div class="wrap mmenu__inner">
      <nav aria-label="Mobile">
        {nav.map((n, i) => (
          <a href={n.href} class="mmenu__link" style={`--i:${i}`}>
            <span class="mono muted">0{i + 1}</span>
            <span>{n.label}</span>
          </a>
        ))}
      </nav>
      <div class="mmenu__foot">
        <a href={`mailto:${site.email}`} class="link">{site.email}</a>
        <div class="mmenu__socials">
          {socials.map((s) => <a href={s.href} target="_blank" rel="noopener" class="mono">{s.label}</a>)}
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .nav { position: fixed; inset: 0 0 auto; z-index: 50; transition: transform 0.6s var(--ease); }
  .nav.is-hidden { transform: translateY(-110%); }
  .nav::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    backdrop-filter: blur(16px) saturate(1.4); -webkit-backdrop-filter: blur(16px) saturate(1.4);
    border-bottom: 1px solid var(--line);
    opacity: 0; transition: opacity 0.4s var(--ease);
  }
  .nav.is-scrolled::before { opacity: 1; }
  .nav__inner { display: flex; align-items: center; justify-content: space-between; height: 76px; gap: 1rem; }

  .nav__logo { display: flex; align-items: center; gap: 0.7rem; font-weight: 600; letter-spacing: -0.02em; }
  .nav__mark { width: 36px; height: 36px; display: grid; place-items: center; }
  .nav__mark svg { width: 100%; height: 100%; transition: transform 0.8s var(--ease); }
  .nav__logo:hover .nav__mark svg { transform: rotate(-90deg); }
  .nav__name { font-size: 1.05rem; }

  .nav__links { display: flex; gap: 0.25rem; padding: 6px; border-radius: 999px; border: 1px solid var(--line); background: color-mix(in srgb, var(--bg-2) 60%, transparent); backdrop-filter: blur(10px); }
  .nav__link { position: relative; display: flex; align-items: baseline; gap: 0.35rem; padding: 0.45rem 0.95rem; border-radius: 999px; font-size: 0.92rem; color: var(--fg-2); transition: color 0.3s, background-color 0.3s; }
  .nav__link:hover { color: var(--fg); }
  .nav__link.is-active { background: var(--fg); color: var(--bg); }
  .nav__idx { font-family: var(--f-mono); font-size: 0.62rem; opacity: 0.55; }
  .nav__roll { position: relative; display: inline-block; overflow: hidden; height: 1.3em; line-height: 1.3em; }
  .nav__roll > span { display: inline-block; transition: transform 0.5s var(--ease); }
  .nav__roll::after { content: attr(data-text); position: absolute; left: 0; top: 100%; transition: transform 0.5s var(--ease); }
  .nav__link:hover .nav__roll > span, .nav__link:hover .nav__roll::after { transform: translateY(-100%); }

  .nav__tools { display: flex; align-items: center; gap: 0.5rem; }
  .nav__k { display: flex; align-items: center; gap: 0.6rem; height: 42px; padding: 0 0.6rem 0 1rem; border-radius: 999px; border: 1px solid var(--line); transition: border-color 0.3s; }
  .nav__k:hover { border-color: var(--line-2); }
  .nav__k .mono { font-size: 0.7rem; }
  kbd { font-family: var(--f-mono); font-size: 0.7rem; padding: 0.2rem 0.45rem; border-radius: 6px; background: var(--bg-3); border: 1px solid var(--line); }
  .nav__theme { width: 42px; height: 42px; display: grid; place-items: center; border-radius: 50%; border: 1px solid var(--line); }
  .nav__theme svg { width: 18px; height: 18px; transition: transform 0.8s var(--ease); }
  :global(:root[data-theme='light']) .nav__theme svg { transform: rotate(180deg); }
  .nav__burger { display: none; width: 42px; height: 42px; border-radius: 50%; border: 1px solid var(--line); position: relative; }
  .nav__burger span { position: absolute; left: 12px; right: 12px; height: 1.5px; background: currentColor; transition: transform 0.5s var(--ease); }
  .nav__burger span:first-child { top: 17px; } .nav__burger span:last-child { top: 23px; }
  .nav.is-open .nav__burger span:first-child { transform: translateY(3px) rotate(45deg); }
  .nav.is-open .nav__burger span:last-child { transform: translateY(-3px) rotate(-45deg); }

  .mmenu { position: fixed; inset: 0; z-index: -2; background: var(--bg); clip-path: circle(0% at calc(100% - 40px) 38px); transition: clip-path 0.8s var(--ease-in-out); visibility: hidden; }
  .nav.is-open .mmenu { clip-path: circle(150% at calc(100% - 40px) 38px); visibility: visible; }
  .mmenu__inner { height: 100%; display: flex; flex-direction: column; justify-content: space-between; padding-top: 110px; padding-bottom: 32px; }
  .mmenu nav { display: flex; flex-direction: column; }
  .mmenu__link { display: flex; align-items: baseline; gap: 1rem; font-size: clamp(2.6rem, 13vw, 4.5rem); letter-spacing: -0.05em; line-height: 1.08; border-bottom: 1px solid var(--line); padding: 0.4rem 0; opacity: 0; transform: translateY(30px); transition: opacity 0.6s var(--ease), transform 0.6s var(--ease); transition-delay: calc(var(--i) * 60ms + 200ms); }
  .nav.is-open .mmenu__link { opacity: 1; transform: none; }
  .mmenu__foot { display: flex; flex-direction: column; gap: 1rem; }
  .mmenu__socials { display: flex; flex-wrap: wrap; gap: 1rem; color: var(--muted); }

  @media (max-width: 900px) {
    .nav__links, .nav__k { display: none; }
    .nav__burger { display: block; }
  }
</style>

<script>
  import { toggleTheme } from '../scripts/theme';

  let lastY = 0;
  function onScroll() {
    const nav = document.querySelector<HTMLElement>('[data-nav]');
    if (!nav) return;
    const y = window.scrollY;
    nav.classList.toggle('is-scrolled', y > 20);
    nav.classList.toggle('is-hidden', y > 300 && y > lastY && !nav.classList.contains('is-open'));
    lastY = y;
  }
  window.addEventListener('scroll', onScroll, { passive: true });

  document.addEventListener('astro:page-load', () => {
    const nav = document.querySelector<HTMLElement>('[data-nav]');
    const burger = nav?.querySelector<HTMLButtonElement>('[data-burger]');
    const menu = nav?.querySelector<HTMLElement>('[data-mmenu]');
    onScroll();
    nav?.querySelector('[data-theme-toggle]')?.addEventListener('click', toggleTheme);
    burger?.addEventListener('click', () => {
      const open = !nav!.classList.contains('is-open');
      nav!.classList.toggle('is-open', open);
      burger.setAttribute('aria-expanded', String(open));
      menu?.setAttribute('aria-hidden', String(!open));
      document.documentElement.style.overflow = open ? 'hidden' : '';
    });
  });
  document.addEventListener('astro:before-swap', () => { document.documentElement.style.overflow = ''; });
</script>
