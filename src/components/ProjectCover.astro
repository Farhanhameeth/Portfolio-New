---
// Project artwork: a screenshot inside a floating window if `cover` exists,
// otherwise a generated poster in the project's colour.
interface Props { title: string; color: string; cover?: string; mark?: string; stack: string[]; eager?: boolean }
const { title, color, cover, mark, stack, eager = false } = Astro.props;
const initials = mark || title.split(/\s+/).filter((w) => /^[A-Z]/.test(w)).map((w) => w[0]).join('').slice(0, 3) || title.slice(0, 2);
---

<div class="cover" style={`--c:${color}`}>
  <div class="cover__glow"></div>
  <div class="cover__grid"></div>
  {cover ? (
    <div class="cover__win">
      <div class="cover__bar"><i></i><i></i><i></i></div>
      <img src={cover} alt={`${title} screenshot`} loading={eager ? 'eager' : 'lazy'} decoding="async" />
    </div>
  ) : (
    <div class="cover__poster" aria-hidden="true">
      <span class="cover__initials">{initials}</span>
      <span class="cover__stack mono">{stack.slice(0, 4).join(' / ')}</span>
    </div>
  )}
</div>

<style>
  .cover { position: relative; width: 100%; height: 100%; overflow: hidden; background: color-mix(in srgb, var(--c) 14%, var(--bg-2)); isolation: isolate; }
  .cover__glow { position: absolute; inset: -30%; background: radial-gradient(closest-side at 70% 30%, color-mix(in srgb, var(--c) 70%, transparent), transparent), radial-gradient(closest-side at 20% 90%, color-mix(in srgb, var(--c) 35%, transparent), transparent); filter: blur(20px); opacity: 0.7; z-index: -1; transition: transform 1.2s var(--ease); }
  .cover__grid { position: absolute; inset: 0; z-index: -1; background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px); background-size: 40px 40px; mask-image: radial-gradient(circle at 50% 50%, #000, transparent 75%); }
  .cover__win { position: absolute; left: 9%; right: 9%; top: 12%; border-radius: 12px; overflow: hidden; background: #fff; box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.55); transform: translateY(6%) rotate(-1.5deg); transition: transform 1s var(--ease); }
  .cover__bar { display: flex; gap: 6px; padding: 9px 12px; background: #ececec; }
  .cover__bar i { width: 9px; height: 9px; border-radius: 50%; background: #d4d4d4; }
  .cover__bar i:first-child { background: #ff5f57; } .cover__bar i:nth-child(2) { background: #febc2e; } .cover__bar i:nth-child(3) { background: #28c840; }
  .cover__win img { width: 100%; height: auto; }
  .cover__poster { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: space-between; padding: 8%; }
  .cover__initials { font-size: clamp(5rem, 14vw, 12rem); line-height: 0.8; font-weight: 600; letter-spacing: -0.08em; color: color-mix(in srgb, var(--c) 85%, var(--fg)); transition: transform 1s var(--ease); }
  .cover__stack { color: var(--fg-2); font-size: 0.7rem; }
  :global(a:hover) .cover__win, :global(.is-hover) .cover__win { transform: translateY(2%) rotate(0deg) scale(1.02); }
  :global(a:hover) .cover__glow { transform: scale(1.15) rotate(8deg); }
  :global(a:hover) .cover__initials { transform: translateX(4%); }
</style>
